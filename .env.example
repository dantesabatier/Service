# Sabatier Service — environment reference
#
# Copy to `.env` and set what your application needs. Every variable here is
# optional: the framework runs with none of them set, and each falls back to the
# default shown. The point of setting them is to move a decision out of code.
#
# Never commit the real `.env`. `JWT_PRIVATE_KEY` in particular is a signing
# key: leaking it lets anyone mint tokens your server will accept.


# ── Environment ──────────────────────────────────────────────────────────────
# Anything other than "production" is treated as a development environment,
# which surfaces errors instead of hiding them. Set this to production before
# the service faces real traffic.
APP_ENV=development


# ── Authentication ───────────────────────────────────────────────────────────
# Setting JWT_PRIVATE_KEY switches the framework into stateless JWT mode.
# Leaving it unset keeps session-based authentication, which is what a
# browser-facing application usually wants.
#
# For an HMAC algorithm (HS256/384/512) this is the shared secret; for RSA
# (RS*/PS*) or ECDSA (ES*) it is the PEM private key.
#JWT_PRIVATE_KEY=
# Default: HS256
#JWT_SIGNATURE_ALGORITHM=HS256
# Stamped as the `iss` claim and validated on the way in. Unset means the
# issuer is not validated at all.
#JWT_ISSUER=https://api.example.com
# Access-token lifetime in seconds. Default: 1800 (30 minutes)
#JWT_VALIDITY_TIME_INTERVAL=1800


# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated. Unset means no cross-origin request is allowed, which is the
# right default for an API with no browser clients. `*` with credentials
# enabled is rejected by browsers, not just by this framework.
#CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
#CORS_ALLOWED_METHODS=GET,POST,PATCH,DELETE,OPTIONS
#CORS_ALLOWED_HEADERS=Authorization,Content-Type,Idempotency-Key
#CORS_EXPOSED_HEADERS=X-RateLimit-Remaining,X-RateLimit-Reset
#CORS_ALLOW_CREDENTIALS=false


# ── Rate limiting ────────────────────────────────────────────────────────────
# Requires one of the ext-apcu / ext-redis / ext-memcached backends to be
# installed; without one, the in-memory store applies per process only.
# Default: true
#RATE_LIMIT_ENABLED=true
# Default: 30
#RATE_LIMIT_MAX_REQUESTS_IP=30
# Default: 120 — an authenticated subject is trusted further than an address.
#RATE_LIMIT_MAX_REQUESTS_USER=120
# Default: 60
#RATE_LIMIT_WINDOW_SECONDS=60


# ── Idempotency ──────────────────────────────────────────────────────────────
# Replay protection for POST and PATCH carrying an `Idempotency-Key` header.
# Default: true
#IDEMPOTENCY_ENABLED=true
# Default: 86400 (24 hours)
#IDEMPOTENCY_TTL=86400


# ── HTTP caching ─────────────────────────────────────────────────────────────
# Default: 0 — nothing is cached unless a responder asks for it.
#HTTP_CACHE_MAX_AGE=0
# private | public. Default: private
#HTTP_CACHE_VISIBILITY=private
# Default: true
#HTTP_CACHE_ETAG_ENABLED=true
#HTTP_CACHE_STALE_WHILE_REVALIDATE=0
#HTTP_CACHE_VARY=Accept,Accept-Encoding
# Static assets are fingerprinted, so they cache for a year. Default: 31536000
#STATIC_RESOURCE_MAX_AGE=31536000
# Comma-separated extra directories served as public static resources.
#STATIC_PUBLIC_DIRECTORIES=


# ── File uploads and downloads ───────────────────────────────────────────────
# A transfer resolves to one subdirectory of the document root and one filename
# inside it. Both must be a single plain component — letters, digits, underscore
# and hyphen — so neither can point outside the directory the policy resolved.
#
# Comma-separated subdirectories that accept transfers. Unset accepts any valid
# single component.
#FILE_TRANSFER_DIRECTORIES=uploads,invoices
# Comma-separated accepted upload extensions, without the dot. Unset does not
# restrict the extension — worth setting on any endpoint open to end users.
#FILE_TRANSFER_ALLOWED_EXTENSIONS=pdf,png,jpg
# Largest accepted upload in bytes. Default: 0 (the transport's
# upload_max_filesize is then the only ceiling).
#FILE_TRANSFER_MAXIMUM_SIZE=0
# Octal permissions applied to an uploaded file. Default: 0777, deliberately
# permissive — a deployment whose writing and reading processes are different
# users cannot read back a stricter file. Tighten it where yours allows.
#FILE_TRANSFER_FILE_PERMISSIONS=0777


# ── Security headers ─────────────────────────────────────────────────────────
# These ship with safe defaults and are sent on every response. Override only
# to loosen or tighten a specific one.
# Unset by default: a CSP that fits one application breaks another.
#SECURITY_CSP=default-src 'self'
# Unset by default. Only send it over HTTPS — a browser that sees it once will
# refuse plain HTTP for the whole max-age.
#SECURITY_HSTS=max-age=31536000; includeSubDomains
# Default: nosniff
#SECURITY_X_CONTENT_TYPE_OPTIONS=nosniff
# Default: SAMEORIGIN
#SECURITY_X_FRAME_OPTIONS=SAMEORIGIN
# Default: strict-origin-when-cross-origin
#SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
# Default: camera=(), microphone=(), geolocation=()
#SECURITY_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()


# ── MCP server ───────────────────────────────────────────────────────────────
# The model is exposed to LLM agents at /mcp. These name the server and point
# at the bundle resources that describe your domain to the agent.
#MCP_SERVER_NAME=example-api
#MCP_SERVER_VERSION=1.0.0
# Comma-separated browser origins allowed to reach /mcp. MCP clients are not
# browsers and send no Origin header, so they are unaffected.
#MCP_ALLOWED_ORIGINS=
# Audience claim a token must carry to reach /mcp. Unset accepts any audience.
#MCP_TOKEN_AUDIENCE=
# Idle session lifetime in seconds, refreshed on every request that carries the
# session. Default: 3600
#MCP_SESSION_TTL=3600
# Bundle resource filenames, resolved under Resources/. Defaults shown.
#MCP_VOCABULARY_FILENAME=mcp_vocabulary.json
#MCP_PREDICATE_EXAMPLES_FILENAME=mcp_predicate_examples.json
#MCP_INSTRUCTIONS_FILENAME=mcp_instructions.txt
#CHAT_INSTRUCTIONS_FILENAME=chat_system_prompt.txt
#WIDGET_INSTRUCTIONS_FILENAME=widget_system_prompt.txt


# ── Web search tool ──────────────────────────────────────────────────────────
# The MCP `web_search` tool stays unavailable until a provider and key are set.
#WEB_SEARCH_PROVIDER=tavily
#WEB_SEARCH_API_KEY=
