{
  "name": "sabatier/service",
  "description": "The Service framework allows you to create fully functional web services in minutes.",
  "keywords": [
    "sabatier",
    "service"
  ],
  "homepage": "https://github.com/dantesabatier/service",
  "license": "MIT",
  "authors": [
    {
      "name": "dantesabatier",
      "email": "dantesabatier@me.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "ext-intl": "*",
    "ext-gettext": "*",
    "ext-dom": "*",
    "ext-ctype": "*",
    "ext-libxml": "*",
    "ext-pdo": "*",
    "ext-zlib": "*",
    "ext-openssl": "*",
    "sabatier/foundation": "@dev",
    "sabatier/coredata": "@dev"
  },
  "config": {
    "platform": {
      "ext-pcntl": "8.5",
      "ext-posix": "8.5"
    }
  },
  "autoload": {
    "psr-4": {
      "Sabatier\\Service\\": "src"
    },
    "files": [
      "src/AuthenticationConstants.php",
      "src/Constants.php",
      "src/ConstantsInternal.php",
      "src/CORSConstants.php",
      "src/JSONWebTokenConstants.php",
      "src/JSONWebTokenErrorCodes.php",
      "src/SessionAdditions.php"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Foundation"
    },
    {
      "type": "path",
      "url": "../CoreData"
    }
  ]
}
