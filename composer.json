{
  "name": "sabatier/service",
  "description": "The Service framework allows you to create fully functional web services in minutes.",
  "keywords": [
    "sabatier",
    "service"
  ],
  "homepage": "https://github.com/dantesabatier/service",
  "license": "MIT",
  "authors": [
    {
      "name": "dantesabatier",
      "email": "dantesabatier@me.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-ctype": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "sabatier/foundation": "@dev",
    "sabatier/coredata": "@dev"
  },
  "suggest": {
    "ext-apcu": "Backs rate limiting, idempotency, the authorization cache and MCP session storage on a single server, with no external service to run.",
    "ext-redis": "Backs rate limiting, idempotency, the authorization cache and MCP session storage across several servers.",
    "ext-memcached": "Alternative shared backend for rate limiting, idempotency and the authorization cache.",
    "phpunit/phpunit": "Runs the optional agent-loop conformance test kit when developing a custom orchestration strategy."
  },
  "config": {
    "platform": {
      "ext-pcntl": "8.5",
      "ext-posix": "8.5"
    }
  },
  "autoload": {
    "psr-4": {
      "Sabatier\\Service\\": "src",
      "Sabatier\\Service\\Testing\\": "tests/Contract"
    },
    "files": [
      "src/AuthenticationConstants.php",
      "src/Constants.php",
      "src/ConstantsInternal.php",
      "src/CORSConstants.php",
      "src/FileTransferConstants.php",
      "src/HTTPCacheConstants.php",
      "src/IdempotencyConstants.php",
      "src/JobConstants.php",
      "src/JSONWebTokenConstants.php",
      "src/JSONWebTokenErrorCodes.php",
      "src/MCPConstants.php",
      "src/MCP/JSONRPCConstants.php",
      "src/MCP/JSONRPCErrorCodes.php",
      "src/RateLimitConstants.php",
      "src/SecurityHeadersConstants.php",
      "src/SessionAdditions.php"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Foundation"
    },
    {
      "type": "path",
      "url": "../CoreData"
    }
  ]
}
