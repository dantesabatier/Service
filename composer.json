{
  "name": "sabatier/service",
  "description": "The Service framework allows you to create fully functional web services in minutes.",
  "keywords": [
    "sabatier",
    "service"
  ],
  "homepage": "https://github.com/dantesabatier/service",
  "license": "MIT",
  "authors": [
    {
      "name": "dantesabatier",
      "email": "dantesabatier@me.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-pcntl": "*",
    "ext-posix": "*",
    "ext-fileinfo": "*",
    "sabatier/foundation": "^1.0-dev",
    "sabatier/coredata": "^1.0-dev"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "vimeo/psalm": "^4.3",
    "phpstan/phpstan": "^1.8",
    "squizlabs/php_codesniffer": "3.*",
    "jetbrains/phpstorm-attributes": "^1.0"
  },
  "config": {
    "platform": {
      "ext-pcntl": "8.1",
      "ext-posix": "8.1"
    }
  },
  "autoload": {
    "psr-4": {
      "Sabatier\\Service\\": "src"
    },
    "files": [
      "src/JSONWebTokenAdditions.php",
      "src/StandardAdditions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Sabatier\\Service\\Test\\": "tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    }
  },
  "scripts": {
    "psalm": "vendor/bin/psalm --config=psalm.xml"
  }
}
