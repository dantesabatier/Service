<?xml version="1.0"?>
<!--suppress XmlDefaultAttributeValue -->
<psalm errorLevel="3" findUnusedCode="false" findUnusedBaselineEntry="true" xmlns="https://getpsalm.org/schema/config">
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <PropertyNotSetInConstructor errorLevel="suppress"/>
        <MissingConstructor errorLevel="suppress"/>
        <RedundantPropertyInitializationCheck errorLevel="suppress"/>
        <InaccessibleProperty errorLevel="suppress"/>
        <ClassMustBeFinal>
            <errorLevel type="suppress">
                <file name="src/Application.php"/>
                <file name="src/Renderer.php"/>
                <file name="src/View.php"/>
            </errorLevel>
        </ClassMustBeFinal>
        <UnresolvableInclude>
            <errorLevel type="suppress">
                <file name="src/Renderer.php"/>
            </errorLevel>
        </UnresolvableInclude>
        <PossiblyNullArgument>
            <errorLevel type="suppress">
                <file name="src/AuthenticationManager.php"/>
            </errorLevel>
        </PossiblyNullArgument>
        <NullableReturnStatement>
            <errorLevel type="suppress">
                <file name="src/InterfaceImplementorResolver.php"/>
            </errorLevel>
        </NullableReturnStatement>
        <InvalidReturnType>
            <errorLevel type="suppress">
                <file name="src/InterfaceImplementorResolver.php"/>
            </errorLevel>
        </InvalidReturnType>
        <RedundantCondition>
            <errorLevel type="suppress">
                <file name="src/AuthorizationService.php"/>
            </errorLevel>
        </RedundantCondition>
        <TypeDoesNotContainNull>
            <errorLevel type="suppress">
                <file name="src/AuthorizationService.php"/>
            </errorLevel>
        </TypeDoesNotContainNull>
        <LessSpecificImplementedReturnType>
            <errorLevel type="suppress">
                <file name="src/StreamResponse.php"/>
            </errorLevel>
        </LessSpecificImplementedReturnType>
        <NoInterfaceProperties errorLevel="suppress"/>
        <InternalClass errorLevel="suppress"/>
        <InternalProperty errorLevel="suppress"/>
        <RiskyTruthyFalsyComparison errorLevel="suppress"/>
        <InvalidAttribute errorLevel="suppress"/>
    </issueHandlers>
    <plugins>
        <pluginClass class="Sabatier\Foundation\Plugins\Psalm\Plugin"/>
    </plugins>
</psalm>
