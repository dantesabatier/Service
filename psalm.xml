<?xml version="1.0"?>
<!--suppress XmlDefaultAttributeValue -->
<psalm errorLevel="4" findUnusedCode="false" findUnusedBaselineEntry="true" xmlns="https://getpsalm.org/schema/config">
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <PropertyNotSetInConstructor errorLevel="suppress"/>
        <MissingConstructor errorLevel="suppress"/>
        <MissingOverrideAttribute>
            <errorLevel type="suppress">
                <file name="src/DefaultAuthorizationService.php"/>
                <file name="src/JSONWebTokenHeader.php"/>
                <file name="src/JSONWebTokenPayload.php"/>
                <file name="src/JSONWebTokenSignature.php"/>
            </errorLevel>
        </MissingOverrideAttribute>
        <RedundantPropertyInitializationCheck errorLevel="suppress"/>
        <InaccessibleProperty errorLevel="suppress"/>
        <InternalClass errorLevel="suppress"/>
        <InternalProperty errorLevel="suppress"/>
        <RiskyTruthyFalsyComparison errorLevel="suppress"/>
        <DuplicateClass errorLevel="suppress"/>
        <NoInterfaceProperties errorLevel="suppress"/>
        <UndefinedDocblockClass errorLevel="suppress"/>
        <NonInvariantDocblockPropertyType errorLevel="suppress"/>
        <ClassMustBeFinal errorLevel="suppress"/>
    </issueHandlers>
</psalm>
